{
  "name": "slidemind",
  "version": "0.1.0",
  "description": "A focused desktop workspace for shaping presentation ideas.",
  "main": "out/main/index.js",
  "author": "SlideMind",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "build": "pnpm check && electron-vite build",
    "package": "pnpm build && electron-builder",
    "package:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64",
    "package:win": "pnpm build && electron-builder --win --x64"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@juicesharp/rpiv-todo": "2.8.0",
    "@univerjs/core": "0.25.1",
    "@univerjs/design": "0.25.1",
    "@univerjs/docs": "0.25.1",
    "@univerjs/docs-ui": "0.25.1",
    "@univerjs/drawing": "0.25.1",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/slides": "0.25.1",
    "@univerjs/slides-ui": "0.25.1",
    "@univerjs/ui": "0.25.1",
    "chokidar": "5.0.0",
    "codemirror": "^6.0.2",
    "diff": "8.0.4",
    "dompurify": "^3.4.14",
    "isomorphic-git": "1.41.9",
    "marked": "^18.0.11",
    "pi-permission-system": "0.8.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
